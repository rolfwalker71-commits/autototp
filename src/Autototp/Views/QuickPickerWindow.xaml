<Window x:Class="Autototp.Views.QuickPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Autototp.Views"
        Title="Account wählen"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="340"
        Height="380"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="True"
        Background="{DynamicResource AppBackgroundBrush}">
    <Border BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            Background="{DynamicResource CardBackgroundBrush}">
        <DockPanel Margin="12">
            <TextBlock DockPanel.Dock="Top"
                       Text="Account für Auto-Fill"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8" />
            <TextBox x:Name="FilterBox"
                     DockPanel.Dock="Top"
                     Style="{StaticResource FluentTextBox}"
                     Margin="0,0,0,8"
                     TextChanged="OnFilterChanged" />
            <TextBlock DockPanel.Dock="Bottom"
                       Text="Enter = einfügen   Esc = schließen   Suche = alle Accounts"
                       Style="{StaticResource MutedText}"
                       Margin="0,8,0,0" />
            <ListBox x:Name="AccountList"
                     Style="{StaticResource AccountListBox}"
                     MouseDoubleClick="OnAccountActivate"
                     KeyDown="OnListKeyDown">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"
                                           Style="{StaticResource MutedText}"
                                           FontWeight="SemiBold"
                                           Margin="2,8,2,6" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource AccountCard}" Padding="10" Margin="0,0,0,6">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <views:AccountLogoTile Grid.Row="0"
                                                       Width="40"
                                                       Height="40"
                                                       Margin="0,0,10,0"
                                                       VerticalAlignment="Top" />
                                <StackPanel Grid.Row="0" Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource AccountNameText}" />
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource MutedText}" />
                                    <TextBlock Text="{Binding FormattedCode}"
                                               Style="{StaticResource CodeText}"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                                <ProgressBar Grid.Row="1"
                                             Grid.ColumnSpan="2"
                                             Style="{StaticResource FluentProgress}"
                                             Value="{Binding Progress, Mode=OneWay}"
                                             Margin="0,8,0,0" />
                                <TextBlock Grid.Row="2"
                                           Grid.ColumnSpan="2"
                                           Text="{Binding RemainingSeconds, StringFormat={}{0}s}"
                                           Style="{StaticResource MutedText}"
                                           Foreground="{DynamicResource SecondaryBrush}"
                                           Margin="0,4,0,0" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</Window>
