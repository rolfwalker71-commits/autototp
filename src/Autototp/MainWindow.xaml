<Window x:Class="Autototp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Autototp"
        Height="640"
        Width="520"
        MinHeight="480"
        MinWidth="420"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="20">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Autototp" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="TOTP-Tokens verwalten und automatisch einfügen"
                           Style="{StaticResource MutedText}"
                           Margin="0,4,0,0" />
            </StackPanel>
        </DockPanel>

        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBox x:Name="SearchBox"
                     Style="{StaticResource FluentTextBox}"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Text="Suchen nach Name, Aussteller oder Fenstertitel…"
                       IsHitTestVisible="False"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0"
                       Visibility="{Binding SearchText, Converter={StaticResource InverseStringToVis}}" />
        </Grid>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Account manuell hinzufügen"
                    Style="{StaticResource PrimaryButton}"
                    Click="OnAddAccount"
                    Margin="0,0,8,0" />
            <Button Content="Import"
                    Style="{StaticResource FluentButton}"
                    Click="OnImport"
                    Margin="0,0,8,0" />
            <Button Content="Einstellungen"
                    Style="{StaticResource FluentButton}"
                    Click="OnSettings" />
        </StackPanel>

        <Grid>
            <ListBox ItemsSource="{Binding FilteredAccounts}"
                     SelectedItem="{Binding SelectedAccount}"
                     Style="{StaticResource AccountListBox}"
                     MouseDoubleClick="OnAccountDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource FluentCard}" Cursor="Hand">
                            <Border.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="Code kopieren" Click="OnCopyCode" />
                                    <MenuItem Header="Bearbeiten" Click="OnEditAccount" />
                                    <MenuItem Header="Löschen" Click="OnDeleteAccount" />
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="{Binding Name}"
                                           FontWeight="SemiBold"
                                           FontSize="15"
                                           TextWrapping="Wrap" />
                                <TextBlock Grid.Row="0"
                                           Grid.Column="1"
                                           Text="{Binding FormattedCode}"
                                           Style="{StaticResource CodeText}"
                                           FontSize="22"
                                           VerticalAlignment="Center"
                                           Margin="12,0,0,0" />
                                <TextBlock Grid.Row="1"
                                           Grid.ColumnSpan="2"
                                           Text="{Binding Subtitle}"
                                           Style="{StaticResource MutedText}"
                                           Margin="0,4,0,10" />
                                <ProgressBar Grid.Row="2"
                                             Grid.ColumnSpan="2"
                                             Style="{StaticResource FluentProgress}"
                                             Value="{Binding Progress, Mode=OneWay}" />
                                <TextBlock Grid.Row="3"
                                           Grid.ColumnSpan="2"
                                           Text="{Binding RemainingSeconds, StringFormat={}{0}s}"
                                           Style="{StaticResource MutedText}"
                                           Margin="0,6,0,0" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="Noch keine Accounts. Füge einen manuell hinzu oder importiere ein 2FAS-Backup."
                       Style="{StaticResource MutedText}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       TextAlignment="Center"
                       MaxWidth="320"
                       Visibility="{Binding HasAccounts, Converter={StaticResource InverseBoolToVis}}" />
        </Grid>
    </DockPanel>
</Window>
